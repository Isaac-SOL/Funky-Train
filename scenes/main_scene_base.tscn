[sub_resource type="GDScript" id="GDScript_bqn3m"]
script/source = "extends RichTextLabel

func _process(delta: float) -> void:
	if not Locomotive.instance:
		return
	var speed_kmh := Locomotive.instance.speed * 3.6
	var speed_kmh_text := str(int(speed_kmh * 10.0))
	text = speed_kmh_text + \" [font_size=12]km/h\"
"

