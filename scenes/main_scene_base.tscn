func _on_drag_started() -> void:
	mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND


func _on_drag_ended(value_changed: bool) -> void:
	mouse_default_cursor_shape = Control.CURSOR_DRAG
"

[sub_resource type="GDScript" id="GDScript_5t7e2"]
script/source = "extends TextureRect

var running_tween: Tween

var boing: bool = false

func _ready() -> void:
	await get_tree().process_frame
	Main.instance.rhythm_sync.beat.connect(func(_b):
		if boing:
			return
		scale = Vector2(1.02, 1.02)
		running_tween = create_tween().set_ease(Tween.EASE_IN_OUT).set_trans(Tween.TRANS_BACK)
		running_tween.tween_property(self, \"scale\", Vector2.ONE, 0.65)
	)

func _gui_input(event: InputEvent) -> void:
	if event is InputEventMouseButton and event.pressed and event.button_index == MOUSE_BUTTON_LEFT:
		if running_tween:
			running_tween.kill()
		boing = true
		scale = scale * 0.92
		running_tween = create_tween().set_ease(Tween.EASE_IN_OUT).set_trans(Tween.TRANS_BACK)
		running_tween.tween_property(self, \"scale\", Vector2.ONE, 0.85)
		running_tween.tween_callback(func(): boing = false)
		%AudioStreamBoing.play()
"

