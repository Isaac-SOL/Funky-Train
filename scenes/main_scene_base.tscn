[sub_resource type="GDScript" id="GDScript_cnexl"]
resource_name = "scale_on_hover"
script/source = "@tool
class_name ScaleOnHover extends Control

@export var scale_factor: Vector2 = Vector2(1.1, 1.1)
@export var scale_duration_in: float = 1.0
@export var scale_duration_out: float = 1.0
@export_tool_button(\"Center Pivot\") var center_pivot_button = center_pivot

var scale_tween: Tween

func _on_hover(hovering: bool):
	if scale_tween:
		scale_tween.kill()
	if hovering:
		scale_tween = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_BACK)
		scale_tween.tween_property(self, \"scale\", scale_factor, scale_duration_in)
	else:
		scale_tween = create_tween().set_ease(Tween.EASE_IN_OUT).set_trans(Tween.TRANS_CUBIC)
		scale_tween.tween_property(self, \"scale\", Vector2.ONE, scale_duration_out)

func center_pivot():
	pivot_offset = size / 2.0
"

